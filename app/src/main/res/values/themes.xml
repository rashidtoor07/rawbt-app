<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- BT Print Theme -->
    <style name="Theme.BTPrint" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/bt_primary</item>
        <item name="colorPrimaryDark">@color/bt_primary_dark</item>
        <item name="colorAccent">@color/bt_accent</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/bt_background</item>
        <item name="android:colorBackground">@color/bt_background</item>
    </style>

    <!-- No ActionBar Theme -->
    <style name="Theme.BTPrint.NoActionBar" parent="Theme.BTPrint">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
